# OpenTIP yapılandırma örneği
# Bu dosyayı .env olarak kopyalayın ve gerçek değerleri girin.
# .env dosyası ASLA sürüm kontrolüne eklenmemelidir.

# --- Uygulama ---
APP_NAME=OpenTIP
ENVIRONMENT=development
LOG_LEVEL=INFO

# Veritabanı ve rapor çıktıları
DATABASE_PATH=./data/opentip.db
REPORT_OUTPUT_DIR=./reports_output

# --- HTTP davranışı (tüm adaptörler için geçerlidir) ---
HTTP_TIMEOUT=15
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=1.5
REQUESTS_PER_MINUTE=30

# --- Zamanlanmış kontrol sistemi ---
# MVP'de varsayılan olarak kapalıdır; arayüzden manuel tetiklenebilir.
SCHEDULER_ENABLED=false
DEFAULT_CHECK_INTERVAL_MINUTES=60

# --- Veri kaynakları: IOC Intelligence ---
# AlienVault OTX (topluluk API'si anahtar olmadan da kısıtlı çalışır)
OTX_API_KEY=
OTX_ENABLED=true

# ThreatFox (abuse.ch) - ücretsiz topluluk API'si, Auth-Key gerektirir
THREATFOX_API_KEY=
THREATFOX_ENABLED=false

# MISP - yalnızca yetkili erişim
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_TLS=true
MISP_ENABLED=false

# --- Veri kaynakları: Breach Intelligence ---
# XposedOrNot - public breach sorgusu anahtarsız, verified domain monitoring anahtarlıdır
XPOSEDORNOT_API_KEY=
XPOSEDORNOT_ENABLED=false

# İzinli breach intelligence sağlayıcısı (yapılandırılmış JSON akışı)
BREACH_FEED_URL=
BREACH_FEED_API_KEY=
BREACH_FEED_ENABLED=false

# --- Veri kaynakları: Dark Web Monitoring (Kategori 2 - izinli kaynak) ---
# Kullanım koşulları izin veren, yapılandırılmış bir izleme kaynağı.
DARKWEB_SOURCE_URL=
DARKWEB_SOURCE_API_KEY=
DARKWEB_SOURCE_ENABLED=false

# --- Dark Web Kaynak Kataloğu (deepdarkCTI) ---
# Küratörlü kaynak listesi (fidye çetesi sızıntı siteleri, forumlar, pazarlar...).
# API anahtarı gerekmez; yalnızca herkese açık GitHub içeriği okunur.
DEEPDARKCTI_BASE_URL=https://raw.githubusercontent.com/fastfire/deepdarkCTI/main/
DEEPDARKCTI_ENABLED=true
